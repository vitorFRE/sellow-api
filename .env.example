# App
PORT=3000
NODE_ENV=development

# Database (local SQLite)
LOCAL_DATABASE_URL="file:dev.db"

# Frontend URL (comma-separated for multiple origins, e.g. production + preview)
FRONTEND_URL=http://localhost:5173

# Auth production: omit or set false
ALLOW_REGISTRATION=true

# Database (production - Turso/libsql)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# JWT
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Apify (token da plataforma — obrigatórias em produção)
# Token da conta Apify usada pela Sellow (não por workspace)
APIFY_TOKEN=
# ID do Actor de Google Maps (ex.: compass~crawler-google-places)
APIFY_GOOGLE_MAPS_ACTOR_ID=
# Segredo validado em POST /webhooks/apify?secret=...
APIFY_WEBHOOK_SECRET=
# URL pública da API (sem path). Usada para registrar webhook ad-hoc no start da run.
# Em local sem tunnel, pode ficar vazio — o cron (1 min) ainda sincroniza as runs.
APIFY_WEBHOOK_BASE_URL=http://localhost:3000
