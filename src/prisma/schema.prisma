generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum LeadStatus {
  IMPORTED
  NEW
  CONTACTED
  QUALIFYING
  BRIEFING
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  password     String?
  role         String    @default("USER")
  isActive     Boolean   @default(true)
  refreshToken String?
  accounts     Account[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Account {
  id                String @id @default(uuid())
  provider          String
  providerAccountId String
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model LossReason {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads Lead[]
}

model Lead {
  id     String     @id @default(uuid())
  name   String
  email  String?    @unique
  phone  String?    @unique
  budget Decimal?
  status LeadStatus @default(NEW)
  source String?

  lossReasonId   String?
  lossReason     LossReason? @relation(fields: [lossReasonId], references: [id])
  lossReasonNote String?

  // Google Maps Leads
  totalScore    Float?
  reviewsCount  Int?
  city          String?
  state         String?
  url           String?
  website       String?
  googlePlaceId String? @unique
  categoryName  String?
  lastImportedAt     DateTime?
  lastManualUpdateAt DateTime?

  // Notes
  notes String?

  followUp LeadFollowUp?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([lossReasonId])
  @@index([lastImportedAt])
  @@index([lastManualUpdateAt])
}

model LeadFollowUp {
  id            String   @id @default(uuid())
  leadId        String   @unique
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  nextContactAt DateTime
  channel       String
  ownerLabel    String
  reminder      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leadId])
  @@index([nextContactAt])
}
