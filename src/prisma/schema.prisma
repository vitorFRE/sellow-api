generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum LeadStatus {
  IMPORTED
  NEW
  CONTACTED
  QUALIFYING
  BRIEFING
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadImportReview {
  POSITIVE
  NEGATIVE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum FeedbackType {
  BUG
  SUGGESTION
  OTHER
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum IntegrationProvider {
  APIFY
}

enum IntegrationType {
  GOOGLE_MAPS_LEADS
}

enum IntegrationRunStatus {
  PENDING
  RUNNING
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  ABORTED
  TIMED_OUT
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String?
  password         String?
  role             String            @default("USER")
  isActive         Boolean           @default(true)
  refreshToken     String?
  accounts         Account[]
  workspaceMembers WorkspaceMember[]
  feedbacks        Feedback[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Account {
  id                String @id @default(uuid())
  provider          String
  providerAccountId String
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Workspace {
  id              String           @id @default(uuid())
  name            String
  members         WorkspaceMember[]
  leads           Lead[]
  lossReasons     LossReason[]
  feedbacks       Feedback[]
  integrationRuns IntegrationRun[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

model LossReason {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leads Lead[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Lead {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  budget      Decimal?
  status      LeadStatus @default(NEW)
  source      String?

  lossReasonId   String?
  lossReason     LossReason? @relation(fields: [lossReasonId], references: [id])
  lossReasonNote String?

  // Google Maps Leads
  totalScore         Float?
  reviewsCount       Int?
  city               String?
  state              String?
  latitude           Float?
  longitude          Float?
  url                String?
  website            String?
  instagram          String?
  facebook           String?
  googlePlaceId      String?
  categoryName       String?
  lastImportedAt     DateTime?
  lastManualUpdateAt DateTime?

  // Notes
  notes String?

  importReview LeadImportReview?

  followUp LeadFollowUp?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, email])
  @@unique([workspaceId, phone])
  @@unique([workspaceId, googlePlaceId])
  @@index([workspaceId])
  @@index([workspaceId, latitude, longitude])
  @@index([status])
  @@index([createdAt])
  @@index([lossReasonId])
  @@index([lastImportedAt])
  @@index([lastManualUpdateAt])
  @@index([importReview])
}

model LeadFollowUp {
  id            String   @id @default(uuid())
  leadId        String   @unique
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  nextContactAt DateTime
  channel       String
  ownerLabel    String
  reminder      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leadId])
  @@index([nextContactAt])
}

model Feedback {
  id          String         @id @default(uuid())
  userId      String
  workspaceId String?
  type        FeedbackType
  message     String
  status      FeedbackStatus @default(OPEN)
  adminNote   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([status])
  @@index([type])
}

model IntegrationRun {
  id              String                @id @default(uuid())
  workspaceId     String
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider        IntegrationProvider
  type            IntegrationType
  status          IntegrationRunStatus  @default(PENDING)
  externalRunId   String?
  externalActorId String?
  datasetId       String?
  input           Json
  importSummary   Json?
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([provider, externalRunId])
  @@index([workspaceId, status])
  @@index([status])
  @@index([workspaceId, type])
}
